{
  "manifest_version": 3,
  "name": "AutoFormPro",
  "version": "1.0.0",
  "description": "AutoFormPro by Antoni",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "action": {},
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-DIxpNRsk.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/content.ts-DIxpNRsk.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
